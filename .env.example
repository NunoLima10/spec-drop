# Cloudflare auth should be handled with `wrangler login` or shell-level
# CLOUDFLARE_API_TOKEN. Do not commit account tokens here.
NODE_ENV=development

# Optional PostHog cookieless browser analytics. Both values are required.
# Enable Cookieless server hash mode and disable stored IP capture in the
# corresponding PostHog project before configuring a hosted deployment.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
