{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "specdrop",
  "compatibility_date": "2026-06-27",
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "ratelimits": [
    {
      "name": "CREATE_SHARE_RATE_LIMITER",
      "namespace_id": "2026071401",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "READ_SHARE_RATE_LIMITER",
      "namespace_id": "2026071402",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "DELETE_SHARE_RATE_LIMITER",
      "namespace_id": "2026071403",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "specdrop-dev",
      "database_id": "76b3f965-36cb-40da-a273-fc24466ffabe",
      "migrations_dir": "../../packages/db/src/db/migrations"
    }
  ],
  "upload_source_maps": true
}
