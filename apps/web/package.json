{
  "name": "@specdrop/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy",
    "d1:migrations:local": "wrangler d1 migrations apply specdrop-dev --local",
    "d1:migrations:remote": "wrangler d1 migrations apply specdrop-dev --remote",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "biome lint .",
    "check": "biome check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/trpc-server": "catalog:",
    "@specdrop/api": "workspace:*",
    "@specdrop/db": "workspace:*",
    "@trpc/client": "catalog:",
    "hono": "catalog:",
    "isbot": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@react-router/dev": "catalog:",
    "@specdrop/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
